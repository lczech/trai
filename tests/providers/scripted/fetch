#!/bin/sh
# Controlled by files in $TRAI_TEST_DIR: counts runs, "slow" delays, "fail" errors.
echo x >> "$TRAI_TEST_DIR/runs"
[ -e "$TRAI_TEST_DIR/slow" ] && sleep 0.5
if [ -e "$TRAI_TEST_DIR/fail" ]; then
  echo '{"error": {"kind": "unavailable", "message": "server down"}}'
else
  echo '{"short": {"used_percent": 50}, "long": {"used_percent": 95}}'
fi
